# Required (the only three secrets). Never commit real values.
GROQ_API_KEY=
GEMINI_API_KEY=
# Neon pooled URL, e.g. postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DATABASE_URL=

# Optional overrides (defaults live in backend/app/config.py)
# DATABASE_URL_DIRECT=            # Alembic URL; default: DATABASE_URL with "-pooler" removed
# APP_ENV=development
# LLM_MODE=live                   # live | mock (mock is for tests only)
# AGENT_MODE=compact              # compact | full
# PRIMARY_LLM_BASE_URL=https://api.groq.com/openai/v1
# PRIMARY_LLM_MODEL=qwen/qwen3.8-27b
# BACKUP_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# BACKUP_LLM_MODEL=gemini-3.5-flash-lite
# LLM_TIMEOUT_S=30
# BACKUP_LLM_TIMEOUT_S=120
# JWT_SECRET=                     # default: HMAC-SHA256 derived from DATABASE_URL
# JWT_TTL_HOURS=8
# DEMO_PASSWORD=migrateiq-demo    # password for the demo accounts operator / approver
# MAX_SOURCE_RECORDS=500
# CORS_ORIGINS=http://localhost:5173
# CORS_ORIGIN_REGEX=
# FAULT_INJECTION_ENABLED=false
# LOG_LEVEL=INFO
